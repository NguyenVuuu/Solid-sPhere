# Browser API base. Keep /api at the end when using a deployed backend.
VITE_API_URL=/api

# Backend origin used by Vite proxy, OAuth redirects and WebSocket connections.
VITE_BACKEND_URL=http://127.0.0.1:8081
VITE_WS_URL=http://127.0.0.1:8081

# Public service URL only; never put payment secrets in VITE_* variables.
VITE_VNPAY_URL=http://localhost:8888

# AI Chat service (Python Flask)
VITE_CHAT_API_URL=http://localhost:5000
