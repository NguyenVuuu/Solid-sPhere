# Required backend secrets/configuration. Set these in the hosting provider,
# Docker Compose, or the IDE run configuration. The local application imports
# this file; deployment platforms should provide the same names as secrets.
SERVER_PORT=8081
FRONTEND_URL=http://localhost:5173

DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>

JWT_SECRET_KEY=<long-random-secret-at-least-32-characters>
SPRING_AI_API_KEY=<spring-ai-provider-key>
GEMINI_API_KEY=<gemini-api-key>
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-app-password>

REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ISSUER_URI=http://localhost:8080/realms/demo
OPENAPI_SERVER_URL=/
